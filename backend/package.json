{
  "name": "biovahack-backend",
  "version": "1.0.0",
  "description": "Backend API for BiovaHack",
  "main": "dist/server.js",
  "scripts": {
    "build": "node init && tsc",
    "start": "node init && node dist/server.js",
    "dev": "node init && ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:db:push": "prisma db push"
  },
  "keywords": [
    "typescript",
    "express",
    "api",
    "biovahack"
  ],
  "author": "",
  "license": "ISC",
  "resolutions": {
    "tar": "^7.5.11"
  },
  "devDependencies": {
    "@prisma/client": "^7.5.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^7.5.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  }
}
