generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


model Team {
  id        Int     @id @default(autoincrement())
  members   User[]
  createdAt DateTime @default(now())
}

model User {
  id            Int        @id @default(autoincrement())
  fullName      String
  email         String     @unique
  university    String
  major         String
  portfolioUrl  String?
  linkedin      String?
  phone         String
  socialPlatform String?
  socialHandle  String?

  teamId        Int?
  team          Team?      @relation(fields: [teamId], references: [id])

  teammates     Teammate[] // invitations

  createdAt     DateTime   @default(now())
}

model Teammate {
  id     Int    @id @default(autoincrement())
  name   String
  email  String  
  role   String

  userId Int     // qui a envoyé l’invite
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum JuryDomain {
  biotech
  tech
  business
}
model JuryMember {
  id          Int         @id @default(autoincrement())
  name        String
  title       String
  description String
  imageUrl    String
  domain      JuryDomain
  githubUrl   String?
  twitterUrl  String?
  linkedinUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AdminRole {
  admin
}

model Admin {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(admin)
  createdAt    DateTime   @default(now())
}